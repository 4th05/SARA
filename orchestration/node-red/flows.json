    "func": "msg.headers = {\n    Authorization: \"Bearer \" + env.get(\"IOE_INTERNAL_TOKEN\"),\n    \"Content-Type\": \"application/json\"\n};\nmsg.requestTimeout = 45000;\nconst gateway = env.get(\"IOE_GATEWAY_URL\") || \"http://127.0.0.1:8080\";\n\nmsg.payload = {event: msg.input, decision: msg.decision};\nmsg.url = gateway + \"/internal/commands/batch\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
