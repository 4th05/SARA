[
  {
    "id": "ioe-workflow",
    "type": "tab",
    "label": "IoE workflow",
    "disabled": false,
    "info": "Real voice/text -> Ollama action list -> pending rooms + spoken acknowledgement -> Arduino simulator -> per-room feedback -> confirmed state + spoken result. Only the device adapter is simulated."
  },
  {
    "id": "ioe-input",
    "z": "ioe-workflow",
    "type": "http in",
    "name": "Recognition / typed request",
    "x": 170,
    "y": 100,
    "wires": [
      [
        "ioe-prepare"
      ]
    ],
    "url": "/ioe/event",
    "method": "post",
    "upload": false
  },
  {
    "id": "ioe-prepare",
    "z": "ioe-workflow",
    "type": "function",
    "name": "Preserve input and call intent service",
    "x": 450,
    "y": 100,
    "wires": [
      [
        "ioe-interpret"
      ]
    ],
    "func": "msg.headers = {\n    Authorization: \"Bearer \" + env.get(\"IOE_INTERNAL_TOKEN\"),\n    \"Content-Type\": \"application/json\"\n};\nmsg.requestTimeout = 45000;\nconst gateway = env.get(\"IOE_GATEWAY_URL\") || \"http://127.0.0.1:8080\";\n\nmsg.input = {...msg.payload};\nmsg.input.request_id = msg.input.request_id || msg._msgid;\nmsg.input.conversation_id = msg.input.conversation_id || \"node-red-demo\";\nmsg.payload = msg.input;\nmsg.url = gateway + \"/internal/interpret\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
  {
    "id": "ioe-interpret",
    "z": "ioe-workflow",
    "type": "http request",
    "name": "LangChain / Ollama interpretation",
    "x": 760,
    "y": 100,
    "wires": [
      [
        "ioe-route"
      ]
    ],
    "method": "POST",
    "ret": "obj",
    "url": "",
    "paytoqs": "ignore",
    "persist": false,
    "senderr": true,
    "headers": []
  },
  {
    "id": "ioe-route",
    "z": "ioe-workflow",
    "type": "function",
    "name": "Command or clarification / reply?",
    "x": 1070,
    "y": 100,
    "wires": [
      [
        "ioe-pending-prepare"
      ],
      [
        "ioe-reply-prepare"
      ]
    ],
    "func": "if (msg.statusCode !== 200) {\n    const detail = typeof msg.payload === \"string\" ? msg.payload : JSON.stringify(msg.payload);\n    throw new Error(\"Gateway HTTP \" + msg.statusCode + \": \" + detail.slice(0, 400));\n}\n\nmsg.decision = msg.payload;\nreturn msg.decision.kind === \"command\" ? [msg, null] : [null, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
  {
    "id": "ioe-pending-prepare",
    "z": "ioe-workflow",
