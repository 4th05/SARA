    "func": "\nmsg.headers = {Authorization: \"Bearer \" + env.get(\"IOE_INTERNAL_TOKEN\"), \"Content-Type\": \"application/json\"};\nmsg.requestTimeout = 45000;\nconst gateway = env.get(\"IOE_GATEWAY_URL\") || \"http://127.0.0.1:8080\";\nmsg.payload = {request_id: msg.batchRequestId, feedback: msg.payload};\nmsg.url = gateway + \"/internal/feedback/batch\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
