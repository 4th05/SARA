  {
    "id": "ioe-failure-prepare",
    "z": "ioe-workflow",
    "type": "function",
    "name": "Record workflow failure in Python State",
    "x": 620,
    "y": 640,
    "wires": [
      [
        "ioe-failure"
      ]
    ],
    "func": "msg.headers = {\n    Authorization: \"Bearer \" + env.get(\"IOE_INTERNAL_TOKEN\"),\n    \"Content-Type\": \"application/json\"\n};\nmsg.requestTimeout = 45000;\nconst gateway = env.get(\"IOE_GATEWAY_URL\") || \"http://127.0.0.1:8080\";\n\nmsg.payload = {request_id: msg.input?.request_id || msg._msgid,\n               message: (msg.error?.message || \"Workflow failed.\").slice(0, 500)};\nmsg.url = gateway + \"/internal/failure\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
