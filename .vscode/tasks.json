{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start IoE system",
      "type": "process",
      "command": "make",
      "args": ["ui"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Stop IoE system",
      "type": "process",
      "command": "make",
      "args": ["stop_ui"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Start Node-RED editor",
      "type": "process",
      "command": "${workspaceFolder}/tools/start_node_red.sh",
      "problemMatcher": []
    }
  ]
}
